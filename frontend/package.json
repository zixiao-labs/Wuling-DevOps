{
  "name": "wuling-frontend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "nasti dev",
    "build": "nasti build",
    "preview": "nasti preview",
    "api:types": "openapi-typescript ../api/openapi.yaml -o src/api/schema.gen.ts",
    "typecheck": "tsc --noEmit && npm run typecheck:help",
    "typecheck:help": "tsc -p tsconfig.help.json --noEmit",
    "help:smoke": "test -f dist-help/server.js && test -f dist-help/enhance.js && node dist-help/prerender.js dist && grep -q help-root dist/help/index.html && test -f dist/help/_assets/enhance.js && test -f dist/help/_assets/search-index.json && test -f dist/help/search/index.html && test -f dist/help/sitemap.xml && grep -q '/help' dist/sw.js",
    "test": "lightning run --root .",
    "test:watch": "lightning watch --root .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "devops",
    "frontend",
    "react",
    "wuling",
    "arknights-endfield"
  ],
  "author": "Zixiao Laboratory",
  "type": "module",
  "license": "Apache-2.0",
  "dependencies": {
    "@heroui/react": "^3.0.4",
    "@heroui/styles": "^3.0.4",
    "chen-the-dawnstreak": "^4.2.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@gravity-ui/icons": "^2.18.0",
    "@lightning-js/lightning": "^1.0.0",
    "@nasti-toolchain/nasti": "^2.0.0",
    "@tailwindcss/node": "^4.3.0",
    "@tailwindcss/oxide": "^4.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "openapi-typescript": "^7.4.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.60.0"
  }
}
