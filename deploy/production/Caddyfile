# Wuling DevOps · production Caddyfile
#
# Caddy reads {$WULING_DOMAIN} / {$ACME_EMAIL} from the env passed in
# docker-compose.prod.yml. It terminates TLS (auto-provisioning via the
# HTTP-01 challenge), serves the static frontend from /srv/wuling-frontend,
# and reverse-proxies everything else (REST + Git smart HTTP) to wuling-api.
#
# Git smart HTTP paths look like /{org}/{project}/{repo}.git/{info/refs,
# git-upload-pack, git-receive-pack}; the path-suffix matcher catches all
# three so the reverse proxy doesn't have to enumerate sub-paths.
#
# Routing uses `handle` blocks (mutually exclusive) instead of free-form
# directives. Caddy auto-orders directives, and `try_files` runs before
# `reverse_proxy` — without `handle`, the SPA fallback rewrites
# /api/v1/auth/register → /index.html before the API matcher gets a chance,
# and the request lands in `file_server` which returns 405 on POST.

{
    email {$ACME_EMAIL}
    # Sane defaults: HTTP/3 on, hide Caddy version header.
    servers {
        protocols h1 h2 h3
    }
}

# Force HTTPS — Caddy does this implicitly for named hosts, but be explicit
# so the redirect is auditable in this file.
http://{$WULING_DOMAIN} {
    redir https://{$WULING_DOMAIN}{uri} permanent
}

{$WULING_DOMAIN} {
    encode gzip zstd

    # ---- API + health/version ------------------------------------------
    handle /api/* {
        reverse_proxy api:8080 {
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    @apiMisc path /healthz /version
    handle @apiMisc {
        reverse_proxy api:8080 {
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # /.well-known/wuling-clients (IdP discovery) is served by the API at
    # the root, not under /api. Without this handle, the SPA catch-all
    # below rewrites it to /index.html and Esperanta's discover() gets
    # HTML back, failing with "expected value at line 1 column 1".
    handle /.well-known/* {
        reverse_proxy api:8080 {
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ---- Git smart HTTP ------------------------------------------------
    @git path_regexp git ^/[^/]+/[^/]+/[^/]+\.git(/|$)
    handle @git {
        reverse_proxy api:8080 {
            # Git smart HTTP can stream large packs — disable flush timeouts
            flush_interval -1
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # ---- Help center (SSR) ---------------------------------------------
    # /help/* is server-rendered by the `help` container for SEO + first paint.
    @help path /help /help/*
    handle @help {
        reverse_proxy help:8081 {
            header_up X-Forwarded-Host {host}
            header_up X-Forwarded-Proto {scheme}
            fail_duration 10s
            max_fails 1
        }
    }

    # ---- Static frontend (Nasti build output) --------------------------
    # Catch-all: anything that didn't match the API/git handlers above.
    handle {
        root * /srv/wuling-frontend
        try_files {path} /index.html  # SPA fallback for client-side routes
        file_server {
            precompressed gzip
        }

        # Only /assets/* is content-hashed by Nasti, so only it may be cached
        # immutably. Brand files keep stable names (they are referenced from
        # index.html and the manifest) — revalidate those daily instead.
        @hashed path /assets/*
        header @hashed Cache-Control "public, max-age=31536000, immutable"

        @brand path /favicon.ico /favicon-32.png /apple-touch-icon.png /icon-*.png /brand-wordmark.png /og-image.png
        header @brand Cache-Control "public, max-age=86400"

        # The service worker and the manifest must never be cached hard, or a
        # client pins itself to a stale build forever. (Nasti emits the manifest
        # as manifest.json — there is no .webmanifest.)
        @noCache path /index.html / /sw.js /manifest.json
        header @noCache Cache-Control "no-cache"
    }

    # Security headers — apply to every response from this site, including
    # API responses. Kept outside the `handle` blocks so they're not
    # duplicated per route.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "interest-cohort=()"
        Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:"
    }

    # ---- Graceful degradation for /help --------------------------------
    handle_errors {
        @helpDown {
            expression {err.status_code} >= 500
            path /help /help/*
        }
        handle @helpDown {
            root * /srv/wuling-frontend
            try_files {path}/index.html {path}.html /help/index.html
            file_server
        }
        handle {
            respond "{err.status_code} {err.text}" {err.status_code}
        }
    }

    log {
        output stdout
        format json
    }
}
