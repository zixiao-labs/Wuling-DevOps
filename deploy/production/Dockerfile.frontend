# --- builder (shared) -------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts

COPY api/openapi.yaml /tmp/api/openapi.yaml

COPY frontend/ ./
COPY scripts/verify-brand-assets.sh /tmp/verify-brand-assets.sh

# One pass emits BOTH: dist/ (client) and dist-help/ (server.js, prerender.js,
# enhance.js) — see environments.ssr in nasti.config.ts.
RUN npm run build

RUN PUBLIC_DIR=/app/public /tmp/verify-brand-assets.sh /app/dist

# Prerender every help page into dist/help/<slug>/index.html. Same code the SSR
# container runs, so the Caddy fallback is byte-identical to the live page.
RUN node dist-help/prerender.js dist \
 && grep -q '/help' dist/sw.js

# --- target: help (SSR) -----------------------------------------------------
FROM node:22-alpine AS help

WORKDIR /srv/help
COPY --from=builder --chown=node:node /app/dist-help ./

ENV NODE_ENV=production \
    WULING_HELP_PORT=8081 \
    WULING_HELP_STATIC_ROOT=/srv/wuling-frontend

USER node
EXPOSE 8081

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8081/_healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["node", "server.js"]

# --- target: static (LAST — untargeted `docker build` keeps nginx behaviour) -
FROM nginx:1.27-alpine AS static

COPY deploy/production/nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /app/dist

RUN sed -i 's|/var/run/nginx.pid|/tmp/nginx.pid|' /etc/nginx/nginx.conf \
 && touch /tmp/nginx.pid && chown nginx:nginx /tmp/nginx.pid

USER nginx
EXPOSE 8080

ENTRYPOINT ["nginx", "-g", "daemon off;"]
